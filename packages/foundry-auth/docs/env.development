# =============================================================================
# foundry-auth Development Environment
# =============================================================================
# Copy this file to .env in your project root and adjust as needed.
# These values are defaults for local development with Keycloak.

# --- OIDC Provider (Required) ---
# Local Keycloak instance
OIDC_ISSUER=http://localhost:8080/realms/foundry
OIDC_CLIENT_ID=foundry-app
OIDC_CLIENT_SECRET=your-client-secret-from-keycloak
OIDC_CALLBACK_URL=http://localhost:8000/auth/callback

# --- Frontend (Required) ---
# URL to redirect to after successful login
FRONTEND_URL=http://localhost:3000

# --- CORS (Optional) ---
# Comma-separated list of frontend origins allowed to make API requests
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Session Management (Optional) ---
# Session store backend: "sqlite"
SESSION_STORE_TYPE=sqlite
# Path for SQLite database (parent directory must exist)
SESSION_STORE_PATH=./data/sessions.db
# Session lifetime in hours
SESSION_TTL_HOURS=24
# Refresh token N minutes before expiry
TOKEN_REFRESH_THRESHOLD_MINUTES=5

# --- Cookie Security (Optional) ---
# Set to "false" for local HTTP development (no HTTPS)
SECURE_COOKIES=false

# --- WebSocket (Optional) ---
# Seconds between periodic session validation checks
WEBSOCKET_SESSION_CHECK_INTERVAL_SECONDS=300
# Maximum WebSocket connection lifetime in seconds
WEBSOCKET_MAX_CONNECTION_SECONDS=3600
