# =============================================================================
# foundry-auth Production Environment
# =============================================================================
# SECURITY: Do NOT commit this file with real values.
# Use a secrets manager (AWS Secrets Manager, Vault, etc.) to inject these
# at runtime. This file serves as a reference for required configuration.

# --- OIDC Provider (Required) ---
# Production OIDC issuer (HTTPS required)
OIDC_ISSUER=https://idp.yourcompany.com/realms/production
OIDC_CLIENT_ID=your-production-client-id
# SECURITY: Inject from secrets manager — never hardcode
OIDC_CLIENT_SECRET=INJECT_FROM_SECRETS_MANAGER
OIDC_CALLBACK_URL=https://api.yourcompany.com/auth/callback

# --- Frontend (Required) ---
FRONTEND_URL=https://app.yourcompany.com

# --- CORS (Optional) ---
# SECURITY: List only production domains — never use wildcards
CORS_ALLOWED_ORIGINS=https://app.yourcompany.com

# --- Session Management (Optional) ---
# Use Redis in production for horizontal scaling and persistence
SESSION_STORE_TYPE=redis
# SECURITY: Inject from secrets manager — contains auth credentials
REDIS_URL=INJECT_FROM_SECRETS_MANAGER
SESSION_TTL_HOURS=8
TOKEN_REFRESH_THRESHOLD_MINUTES=5

# --- Cookie Security (Optional) ---
# SECURITY: Must be "true" in production (requires HTTPS)
SECURE_COOKIES=true

# --- WebSocket (Optional) ---
# More frequent checks in production for faster revocation
WEBSOCKET_SESSION_CHECK_INTERVAL_SECONDS=120
WEBSOCKET_MAX_CONNECTION_SECONDS=3600
