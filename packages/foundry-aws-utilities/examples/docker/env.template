# DynamoDB MCP Server Configuration

# uv Package Manager Configuration
# foundry-aws-utilities resolves from the package index pinned in pyproject.toml
# ([tool.uv.sources]); replace its placeholder URL with your index. Set this only
# if you also want uv to search an extra index:
#   UV_EXTRA_INDEX_URL=https://pypi.internal.example.com/simple
UV_EXTRA_INDEX_URL=

# AWS Configuration (for LocalStack)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=strands-storage
DYNAMODB_RESEARCH_TABLE=research-documents

# LocalStack Configuration
SERVICES=dynamodb
DEBUG=1
LOCALSTACK_HOST=localhost

# MCP Server Configuration
MCP_SERVER_PORT=9003
MCP_SERVER_HOST=0.0.0.0

# Development Settings
DOCKER_REBUILD=false
LOG_LEVEL=INFO
